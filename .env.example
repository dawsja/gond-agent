# SETUP
#   cp .env.example .env
#   openssl rand -base64 32
# Paste the command's output into BETTER_AUTH_SECRET below, then run:
#   docker compose config --quiet
#   docker compose pull
#   docker compose up -d
# Keep .env private and keep the same auth secret across restarts and upgrades.
# Do not paste a real secret into this example file or commit .env.

# AUTHENTICATION — required
# At least 32 characters. The openssl command above generates 32 random bytes.
BETTER_AUTH_SECRET=
# Exact browser origin (scheme + hostname + port), without /agents or /api.
# Use your public HTTPS origin behind a reverse proxy; match PORT if accessed directly.
BETTER_AUTH_URL=http://localhost:8787
# The first account can register on an empty instance and becomes administrator.
# Set true to allow additional email/password and OIDC users to register.
ALLOW_SIGNUP=false
# Configure OIDC in Settings after signing in; no OIDC secrets belong in this file.

# SERVER
# Published host port; the service listens on 8787 inside its container.
PORT=8787
# Bootstrap locally first. Use 0.0.0.0 only when the host should accept remote traffic.
BIND_ADDRESS=127.0.0.1
# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false

# Configure model API URLs, API keys and model IDs in the browser setup process.
# An administrator can change them later under Settings → Model providers.
# Each account can instead sign in with ChatGPT under Settings → Models → ChatGPT plan;
# no environment variables are needed, and ChatGPT tokens are encrypted with BETTER_AUTH_SECRET.
# Claude Code and Codex agents were removed; the built-in agent runs every task.

# DOCKER IMAGES — prebuilt packages; no local build required
GOND_AGENT_IMAGE=ghcr.io/dawsja/gond-agent:main
GOND_AGENT_WORKER_IMAGE=ghcr.io/dawsja/gond-agent-worker:main
# Update both together with docker compose pull && docker compose up -d.
# To pin a release, use the same version tag on both images.
# Optional source builds use docker-compose.build.yml; see README.md.
# Private registry packages require docker login ghcr.io.

# HOST PATHS — the Docker socket must already exist
# Relative paths are resolved next to docker-compose.yml. Absolute paths work too.
# Docker socket access gives the Gond Agent service control of this Docker host.
# Agent containers never receive this socket. Use a dedicated trusted host.
DOCKER_SOCKET_PATH=/var/run/docker.sock
# Sign in to GitHub in Plugins → Connections as an administrator.
# No host GitHub CLI login or credential-directory mount is required.
# Accounts, images, history and SQLite persist in the named gond-agent-data volume.

# WORKSPACE LIMITS — operational resource limits shared by all accounts
# Each run has a private workspace volume; containers share the host kernel.
# MAX_ACTIVE_RUNS: 1–200 distinct live + booting workspaces, including idle/stopped ones.
# CPUs: 1–64; RAM: 512–65536 MiB. No active-workspace time or idle budget.
MAX_ACTIVE_RUNS=5
# With waiting work and full capacity, close clean, pushed, ready workspaces idle this long.
# No pending messages/questions/CI watch/kept work; oldest first. 0 disables.
GOND_AGENT_IDLE_RELEASE_SECONDS=120
# Failed workspaces retain unpushed work and capacity for this many minutes; 0 releases immediately.
GOND_AGENT_FAILED_KEEP_MINUTES=60
RUN_CPUS=2
RUN_MEMORY_MB=2048

# Persistent waiting queue for browser/HTTP and MCP starts and closed-workspace follow-ups.
# Positive integers only: total waiting runs, waiting runs per account, maximum wait hours.
# Queue expiry fails waiting work only; it never times out an active workspace.
GOND_AGENT_QUEUE_MAX=50
GOND_AGENT_QUEUE_MAX_PER_ACCOUNT=10
GOND_AGENT_QUEUE_WAIT_HOURS=24
# Close retained workspaces to free slots and start waiting work automatically.
# Stop cancels waiting work but preserves live workspaces and their occupied slots.
# Scheduled runs do not queue: the scheduler retries on later ticks at capacity.

# CHECKPOINT FOUNDATION — not yet connected to RunService or forwarded by Compose.
# Storage module defaults: positive integers, total MiB and retention days.
# Bundles contain unencrypted source code; keep the API data volume/backups private.
# GOND_AGENT_CHECKPOINT_MAX_MB=1024
# GOND_AGENT_CHECKPOINT_RETENTION_DAYS=7
# Reserved for recovery integration: default on, 0 disables; currently has no effect.
# GOND_AGENT_AUTO_RESUME=1

# Optional commit identity overrides; defaults come from the connected GitHub account.
GOND_AGENT_COMMIT_NAME=
GOND_AGENT_COMMIT_EMAIL=

# Model request inactivity watchdog in minutes (not a turn budget); 0 disables.
MODEL_STALL_MINUTES=10

# Plan reminder interval in main model rounds; 0 disables reminders.
GOND_AGENT_PLAN_REMINDER_EVERY=6
# Plan continuation nudges per user turn; 0 disables, capped at 2.
GOND_AGENT_PLAN_NUDGE_LIMIT=2

# Web search attempts per run, across follow-ups and worker restarts; 0 is unlimited.
GOND_AGENT_WEB_SEARCH_LIMIT=30

# Human/bot question wait only (not a run budget); 0 waits indefinitely.
GOND_AGENT_QUESTION_WAIT_MINUTES=240

# Post-push CI fix rounds per run (durable); default 0 (OFF), range 0–10.
# Board decision: keep OFF until checkpoint resume is available.
# Opt-in closes the workspace after a pushed turn; reopened follow-ups/CI fixes
# lose earlier model history because the runner conversation exists only in process.
# Use approval gates/protected environments for branch-push workflows exposing secrets.
GOND_AGENT_CI_FIX_ROUNDS=0
# Maximum CI wait after each new push, in minutes; range 1–120.
GOND_AGENT_CI_WAIT_MINUTES=20
